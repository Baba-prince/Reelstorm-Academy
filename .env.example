# REELSTORM ACADEMY OS — copy to ../.env and fill secrets
# cp infra/.env.example .env

NODE_ENV=development

# Apps
API_PORT=4000
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Supabase / Postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Use pooled URL for Prisma if available; directUrl for migrations
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# S3 / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=reelstorm
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PUBLIC_URL=http://127.0.0.1:9000/reelstorm

# Uploads
UPLOAD_TMP_DIR=./tmp/uploads
MAX_VIDEO_UPLOAD_GB=2

# Orchestration — DashScope primary, Ollama local fallback
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Video providers
VIDEO_PROVIDER=auto
SEEDANCE_API_KEY=
KLING_API_KEY=
VEO_API_KEY=
GOOGLE_API_KEY=
MOCK_VIDEO_GEN=1

# Voice Forge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Google OAuth (configure same Client ID/Secret in Supabase Auth → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Hosts
MARKETING_URL=https://reelstorm.uk
APP_URL=https://app.reelstorm.uk
NEXT_PUBLIC_MARKETING_URL=https://reelstorm.uk
NEXT_PUBLIC_APP_URL=https://app.reelstorm.uk

# Stripe (VisaVideos Journey / Journey Pro prices)
STRIPE_SECRET_KEY=
STRIPE_TIER_WEBHOOK_SECRET=
STRIPE_PRICE_STORM=price_1TyGglKFjjrlm6Pq5miSVDh6
STRIPE_PRICE_STORM_PRO=price_1TyGgyKFjjrlm6PqObBXjtrj
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

WORKER_CONCURRENCY=2
