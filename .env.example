# REELSTORM ACADEMY OS — copy to .env and fill secrets
# Production 1k guide: docs/PRODUCTION_APIS_1K.md

NODE_ENV=development

# Apps
API_PORT=4000
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Supabase / Postgres (use Pro for ~1000 users; pooler :6543 on VPS)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Object storage — Cloudflare R2 preferred for production 1k
STORAGE_PROVIDER=R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=reelstorm-archive5-prod
# R2_PUBLIC_URL=https://archive5.reelstorm.uk
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Or map into S3_* :
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_BUCKET=reelstorm-archive5-prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://archive5.reelstorm.uk
# Dev MinIO / disk staging:
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=reelstorm
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PUBLIC_URL=http://127.0.0.1:9000/reelstorm
S3_FORCE_PATH_STYLE=true
# S3_LOCAL_OK=1

# Uploads
UPLOAD_TMP_DIR=./tmp/uploads
MAX_VIDEO_UPLOAD_GB=2

# Orchestration — DashScope primary for production (Ollama = local only)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Video providers — MOCK_VIDEO_GEN=0 required for production
VIDEO_PROVIDER=auto
SEEDANCE_API_KEY=
KLING_API_KEY=
VEO_API_KEY=
GOOGLE_API_KEY=
MOCK_VIDEO_GEN=0

# Template Room stock intros — Pixabay PRIMARY (~6k/hr). Pexels paused.
# Never commit real keys — set locally / on VPS only.
INTRO_STOCK_PRIMARY=pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Pixabay: https://pixabay.com/api/docs/ — rotate if key was exposed in chat/screenshots

# Voice Forge — ElevenLabs Creator/Pro for ~1000 users
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Google OAuth (configure same Client ID/Secret in Supabase Auth → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Hosts
MARKETING_URL=https://reelstorm.uk
APP_URL=https://app.reelstorm.uk
NEXT_PUBLIC_MARKETING_URL=https://reelstorm.uk
NEXT_PUBLIC_APP_URL=https://app.reelstorm.uk

# Stripe — use sk_live_ / pk_live_ for production charges
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_TIER_WEBHOOK_SECRET=
STRIPE_PRICE_STORM=price_1TyGglKFjjrlm6Pq5miSVDh6
STRIPE_PRICE_STORM_PRO=price_1TyGgyKFjjrlm6PqObBXjtrj
STRIPE_PRICE_PREMIUM_PRO=
# Create Stripe products: Basic $49 · Premium $99 · Premium Pro $199 — then paste price_… IDs above
# RTC: 1 RTC = 1 min master · 1 set = 5 RTC
# Webhook endpoint: https://app.reelstorm.uk/api/billing/stripe-webhook

# ReelStorm Studio — central minute control + GPU saver (RunPod)
STUDIO_LICENSE_SECRET=generate_a_long_random_secret
# Live pod xuvnute41511og — expose HTTP 8000; weights on /workspace (0 MB to users)
RUNPOD_SAVER_URL=https://xuvnute41511og-8000.proxy.runpod.net/generate
# R2 for generated videos (saver uploads directly; VPS only stores URL + minutes)
# R2_BUCKET_VIDEOS=reelstorm-videos
# R2_PUBLIC_URL=https://videos.reelstorm.uk
# STRIPE_PRICE_STUDIO_STARTER=price_…
# STRIPE_PRICE_STUDIO_PRO=price_…
# STRIPE_PRICE_STUDIO_AGENCY=price_…
# STRIPE_PRICE_STUDIO_UNLIMITED=price_…
# Weights stay on RunPod volume — do NOT ship 4.2GB in desktop installer

# VPS multi-project isolation (IONOS)
# API_PORT=4017
# API_HOST=127.0.0.1
# PORT=3017
# REDIS_URL=redis://127.0.0.1:6379/17
# BULLMQ_PREFIX=reelstorm

# Captain admin console — only this email may access /admin + /api/admin/*
ADMIN_EMAIL=olabamiji.kolabalogun@gmail.com

# Scale for ~1000 users
WORKER_CONCURRENCY=8
