# REELSTORM ACADEMY OS — copy to .env and fill secrets
# Production 1k guide: docs/PRODUCTION_APIS_1K.md

NODE_ENV=development

# Apps
API_PORT=4000
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Supabase / Postgres (use Pro for ~1000 users; pooler :6543 on VPS)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Object storage — local MinIO for dev; Cloudflare R2 or AWS S3 for production 1k
# Dev MinIO:
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=reelstorm
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PUBLIC_URL=http://127.0.0.1:9000/reelstorm
S3_FORCE_PATH_STYLE=true
# Prod R2 example (replace above):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.reelstorm.uk

# Uploads
UPLOAD_TMP_DIR=./tmp/uploads
MAX_VIDEO_UPLOAD_GB=2

# Orchestration — DashScope primary for production (Ollama = local only)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Video providers — MOCK_VIDEO_GEN=0 required for production
VIDEO_PROVIDER=auto
SEEDANCE_API_KEY=
KLING_API_KEY=
VEO_API_KEY=
GOOGLE_API_KEY=
MOCK_VIDEO_GEN=0

# Voice Forge — ElevenLabs Creator/Pro for ~1000 users
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Google OAuth (configure same Client ID/Secret in Supabase Auth → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Hosts
MARKETING_URL=https://reelstorm.uk
APP_URL=https://app.reelstorm.uk
NEXT_PUBLIC_MARKETING_URL=https://reelstorm.uk
NEXT_PUBLIC_APP_URL=https://app.reelstorm.uk

# Stripe — use sk_live_ / pk_live_ for production charges
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_TIER_WEBHOOK_SECRET=
STRIPE_PRICE_STORM=price_1TyGglKFjjrlm6Pq5miSVDh6
STRIPE_PRICE_STORM_PRO=price_1TyGgyKFjjrlm6PqObBXjtrj
# Webhook endpoint: https://app.reelstorm.uk/api/billing/stripe-webhook

# VPS multi-project isolation (IONOS)
# API_PORT=4017
# API_HOST=127.0.0.1
# PORT=3017
# REDIS_URL=redis://127.0.0.1:6379/17
# BULLMQ_PREFIX=reelstorm

# Scale for ~1000 users
WORKER_CONCURRENCY=8
