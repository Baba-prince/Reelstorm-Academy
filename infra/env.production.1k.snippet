# Paste into VPS /opt/reelstorm-os/.env for production ~1000 users
# Keep MinIO values for local only — replace these on the server.

MOCK_VIDEO_GEN=0
WORKER_CONCURRENCY=8
VIDEO_PROVIDER=auto

# Cloudflare R2 (replace ACCOUNT_ID + keys)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_BUCKET=reelstorm
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.reelstorm.uk

# AI
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Stripe LIVE (not sk_test)
STRIPE_SECRET_KEY=sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_TIER_WEBHOOK_SECRET=whsec_
# Webhook: https://app.reelstorm.uk/api/billing/stripe-webhook
