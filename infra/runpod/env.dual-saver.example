# Copy to /workspace/.env on LIVE pod xuvnute4l51iog (Network Volume reelstorm-weights).
# Also mirror the same R2_* + RUNPOD_* block into VPS /opt/reelstorm-os/.env
# NEVER commit real keys.

# ── SAVER 1: Cloudflare R2 (terabyte cloud — videos + weights backup) ──
R2_ACCOUNT_ID=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# aliases accepted by server.py
# R2_KEY=
# R2_SECRET=
R2_BUCKET_WEIGHTS=reelstorm-weights
R2_BUCKET_VIDEOS=reelstorm-videos
R2_PUBLIC_URL=https://videos.reelstorm.uk
R2_REGION=auto

# ── SAVER 2: RunPod GPU (live weights in /workspace → VRAM) ──
RUNPOD_API_KEY=
RUNPOD_POD_ID=xuvnute4l51iog
RUNPOD_SAVER_URL=https://xuvnute4l51iog-8000.proxy.runpod.net/generate
RUNPOD_VOLUME_PATH=/workspace
RUNPOD_COMFYUI_INTERNAL=http://127.0.0.1:8188
RUNPOD_FASTAPI_INTERNAL=http://127.0.0.1:8000
SKYREELS_CKPT=/workspace/skyreels-1.3b-4.2GB
# MOCK_GENERATE=1 until Comfy + SkyReels node validated
MOCK_GENERATE=0
PORT=8000
