generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  DRAFT
  WORLD_BUILDING
  STORYBOARD
  GENERATING
  ARCHIVED
  MERGED
  FAILED
}

enum UploadStatus {
  PENDING
  UPLOADED
  ANALYZING
  EXTRACTING
  READY
  FAILED
}

enum BlockStatus {
  PENDING
  RENDERING
  QC
  ARCHIVED
  FAILED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum SubTier {
  free
  storm
  storm_pro
  premium_pro
  network
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  avatarUrl            String?
  supabaseId           String?  @unique
  tier                 SubTier  @default(free)
  onboardingCompleted  Boolean  @default(false)
  onboardingJson       Json?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  projects             Project[]
  teamMembers          TeamMember[]
  apiKeys              ApiKey[]
  wallet               RtcWallet?
  tenantsOwned         Tenant[] @relation("TenantOwner")
  blueprints           Blueprint[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  id     String @id @default(cuid())
  role   String @default("producer")
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Project {
  id          String        @id @default(cuid())
  title       String
  logline     String?
  script      String?
  status      ProjectStatus @default(DRAFT)
  ownerId     String
  teamId      String?
  templateId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id])
  team        Team?         @relation(fields: [teamId], references: [id])
  template    VideoTemplate? @relation(fields: [templateId], references: [id])
  uploads     VideoUpload[]
  blocks      Block[]
  assets      Asset[]
  soulIds     SoulIdentity[]
  rooms       RoomPlate[]
  storyboards StoryboardFrame[]
  masters     MasterCut[]
  voices      VoiceProfile[]
  blueprints  Blueprint[]
}

/// BOT Director Wizard — Movie Blueprint feed for the factory
model Blueprint {
  id          String   @id @default(cuid())
  userId      String?
  projectId   String?
  rawIdea     String?
  videoUrl    String?
  uploadId    String?
  templateId  String?
  audience    String?
  status      String   @default("draft") // draft | ready | fed
  loglines    Json?
  worldBible  Json?
  sceneMap    Json?
  shotList    Json?
  templateDNA Json?
  stableIds   Json?
  budgetJson  Json?
  voiceover   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model VideoUpload {
  id           String       @id @default(cuid())
  projectId    String?
  uploaderId   String?
  filename     String
  mimeType     String
  bytes        BigInt
  s3Key        String
  s3Url        String?
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  status       UploadStatus @default(PENDING)
  progressPct  Int          @default(0)
  progressMsg  String?
  error        String?
  analysisJson Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project?     @relation(fields: [projectId], references: [id])
  templates    VideoTemplate[]
  blocks       Block[]
}

model VideoTemplate {
  id            String   @id @default(cuid())
  name          String
  stylePreset   String
  sourceUploadId String
  durationSec   Float
  fps           Float    @default(24)
  aspectRatio   String   @default("16:9")
  lut           String?
  templateJson  Json
  s3Key         String?
  thumbnailUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sourceUpload  VideoUpload @relation(fields: [sourceUploadId], references: [id])
  projects      Project[]
}

/** Stock intro clips cached from Pexels (primary) / Pixabay (backup) → R2 */
model IntroTemplate {
  id           String   @id @default(cuid())
  type         String   @default("intro")
  category     String
  name         String
  source       String
  externalId   String
  r2Key        String?
  r2Url        String?
  thumbnailUrl String?
  coverUrl     String?
  durationSec  Float    @default(0)
  tags         String[] @default([])
  license      String   @default("free-commercial")
  query        String?
  bytes        BigInt?
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, externalId])
  @@index([type, category])
}

model Block {
  id           String      @id @default(cuid())
  projectId    String
  uploadId     String?
  index        Int
  title        String
  durationSec  Float       @default(300)
  status       BlockStatus @default(PENDING)
  videoS3Key   String?
  jsonS3Key    String?
  archive5Json Json?
  templateId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id])
  upload       VideoUpload? @relation(fields: [uploadId], references: [id])

  @@unique([projectId, index])
}

model Asset {
  id        String   @id @default(cuid())
  projectId String?
  type      String
  key       String
  url       String?
  mimeType  String?
  bytes     BigInt?
  checksum  String?
  labels    String[] @default([])
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id])
}

model SoulIdentity {
  id        String   @id @default(cuid())
  projectId String
  name      String
  faceHash  String
  frontKey  String?
  leftKey   String?
  rightKey  String?
  threeQKey String?
  loraRef   String?
  locked    Boolean  @default(true)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model RoomPlate {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  wideKey       String?
  mediumKey     String?
  oshKey        String?
  closeKey      String?
  lightingLocked Boolean @default(true)
  lut           String?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id])
}

model StoryboardFrame {
  id        String   @id @default(cuid())
  projectId String
  shotIndex Int
  prompt    String?
  imageKey  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model MasterCut {
  id        String   @id @default(cuid())
  projectId String
  title     String
  blockIds  String[]
  s3Key     String?
  durationSec Float?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

/// Sound Studio — cloned / library voices for Voice Forge
model VoiceProfile {
  id           String   @id @default(cuid())
  projectId    String?
  name         String
  provider     String   @default("elevenlabs")
  providerVoiceId String?
  sampleAssetIds String[] @default([])
  status       String   @default("ready") // pending | cloning | ready | failed
  error        String?
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project? @relation(fields: [projectId], references: [id])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // dashscope | elevenlabs | openai | ollama
  label     String
  keyEnc    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, provider, label])
}

model JobRecord {
  id        String    @id @default(cuid())
  queue     String
  jobId     String    @unique
  status    JobStatus @default(QUEUED)
  payload   Json
  result    Json?
  error     String?
  progress  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Academy studio running ReelStorm under their own brand
model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  ownerId       String
  tier          SubTier  @default(storm_pro)
  status        String   @default("active") // active | suspended
  customDomain  String?
  webhookUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation("TenantOwner", fields: [ownerId], references: [id])
  brand         TenantBrand?
  wlKeys        WhiteLabelKey[]
  wallet        RtcWallet?
}

model TenantBrand {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  productName  String
  monogram     String  @default("RS")
  primaryHex   String  @default("#7C3AED")
  accentHex    String  @default("#00D9FF")
  ctaHex       String  @default("#FF7A00")
  bgHex        String  @default("#080808")
  logoUrl      String?
  supportEmail String?
  hideReelstorm Boolean @default(false)
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Opaque key for Academy white-label REST API (rs_live_…)
model WhiteLabelKey {
  id         String    @id @default(cuid())
  tenantId   String
  label      String
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]  @default(["templates:read", "generate:write", "archive:read"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RtcWallet {
  id             String   @id @default(cuid())
  userId         String?  @unique
  tenantId       String?  @unique
  balanceRtc     Int      @default(0)
  lifetimeIn     Int      @default(0)
  lifetimeOut    Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  ledger         RtcLedger[]
}

model RtcLedger {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // GRANT | PURCHASE | DEBIT_ARCHIVE5 | DEBIT_GENERATE | ADJUST | REFUND
  amountRtc   Int      // signed: +credit / -debit
  balanceAfter Int
  refType     String?
  refId       String?
  note        String?
  createdAt   DateTime @default(now())
  wallet      RtcWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}
