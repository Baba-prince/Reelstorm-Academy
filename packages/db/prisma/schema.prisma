generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  DRAFT
  WORLD_BUILDING
  STORYBOARD
  GENERATING
  ARCHIVED
  MERGED
  FAILED
}

enum UploadStatus {
  PENDING
  UPLOADED
  ANALYZING
  EXTRACTING
  READY
  FAILED
}

enum BlockStatus {
  PENDING
  RENDERING
  QC
  ARCHIVED
  FAILED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum SubTier {
  free
  storm
  storm_pro
  premium_pro
  network
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  avatarUrl            String?
  supabaseId           String?  @unique
  tier                 SubTier  @default(free)
  /// Denormalized mirror of wallet.balanceRtc for free-demo funnel (source of truth remains RtcWallet)
  rtcBalance           Int      @default(1)
  freeDemoUsed         Boolean  @default(false)
  freeDemoGrantedAt    DateTime?
  onboardingCompleted  Boolean  @default(false)
  onboardingJson       Json?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  projects             Project[]
  teamMembers          TeamMember[]
  apiKeys              ApiKey[]
  wallet               RtcWallet?
  tenantsOwned         Tenant[] @relation("TenantOwner")
  blueprints           Blueprint[]
  cloneJobs            CloneJob[]
  ytChannels           YtChannel[]
  ytScripts            YtScript[]
  contentCalendar      ContentCalendarEntry[]
  studioLicenses       StudioLicense[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  id     String @id @default(cuid())
  role   String @default("producer")
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Project {
  id          String        @id @default(cuid())
  title       String
  logline     String?
  script      String?
  status      ProjectStatus @default(DRAFT)
  ownerId     String
  teamId      String?
  templateId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id])
  team        Team?         @relation(fields: [teamId], references: [id])
  template    VideoTemplate? @relation(fields: [templateId], references: [id])
  uploads     VideoUpload[]
  blocks      Block[]
  assets      Asset[]
  soulIds     SoulIdentity[]
  rooms       RoomPlate[]
  storyboards StoryboardFrame[]
  masters     MasterCut[]
  voices      VoiceProfile[]
  blueprints  Blueprint[]
  studioSets  StudioSet[]
}

/// Full Studio Set — Room + Artist + Imagery lock before Director generate
model StudioSet {
  id               String          @id @default(cuid())
  projectId        String
  title            String          @default("Studio Set")
  status           String          @default("draft") // draft | building | ready | applied
  completenessPct  Int             @default(0)
  seedPackId       String?
  appliedAt        DateTime?
  meta             Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id])
  rooms            SceneSet[]
  artists          ArtistProfile[]
  imagery          ImageryPack[]

  @@index([projectId, createdAt])
  @@index([status])
}

/// Studio Room — multi-angle scene background / location set
model SceneSet {
  id              String    @id @default(cuid())
  studioSetId     String
  name            String
  locationKind    String    @default("generic")
  requiredAngles  String[]  @default(["establishing", "wide", "medium", "osh", "close"])
  platesJson      Json      @default("{}")
  promptDna       String?
  lightingNotes   String?
  lut             String?
  locked          Boolean   @default(false)
  seedPackId      String?
  roomPlateId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  studioSet       StudioSet @relation(fields: [studioSetId], references: [id], onDelete: Cascade)

  @@index([studioSetId])
}

/// Artist Studio — cast/character multi-angle identity (extends Soul)
model ArtistProfile {
  id              String    @id @default(cuid())
  studioSetId     String
  soulId          String?
  name            String
  role            String    @default("lead")
  wardrobeNotes   String?
  bodyNotes       String?
  requiredAngles  String[]  @default(["front", "left", "right", "threeQuarter"])
  platesJson      Json      @default("{}")
  importSource    String    @default("manual") // upload | image_url | video_url | manual | seed
  importUrl       String?
  locked          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  studioSet       StudioSet @relation(fields: [studioSetId], references: [id], onDelete: Cascade)

  @@index([studioSetId])
  @@index([soulId])
}

/// Imagery Studio — style/aesthetic pack, prompt-customizable backgrounds
model ImageryPack {
  id                String    @id @default(cuid())
  studioSetId       String
  name              String
  stylePreset       String
  aesthetic         String?
  prompt            String
  customizedPrompt  String?
  sceneSetId        String?
  lut               String?
  mood              String[]  @default([])
  locked            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  studioSet         StudioSet @relation(fields: [studioSetId], references: [id], onDelete: Cascade)

  @@index([studioSetId])
}

/// BOT Director Wizard — Movie Blueprint feed for the factory
model Blueprint {
  id          String   @id @default(cuid())
  userId      String?
  projectId   String?
  rawIdea     String?
  videoUrl    String?
  uploadId    String?
  templateId  String?
  audience    String?
  status      String   @default("draft") // draft | ready | fed
  loglines    Json?
  worldBible  Json?
  sceneMap    Json?
  shotList    Json?
  templateDNA Json?
  stableIds   Json?
  budgetJson  Json?
  voiceover   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model VideoUpload {
  id           String       @id @default(cuid())
  projectId    String?
  uploaderId   String?
  filename     String
  mimeType     String
  bytes        BigInt
  s3Key        String
  s3Url        String?
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  status       UploadStatus @default(PENDING)
  progressPct  Int          @default(0)
  progressMsg  String?
  error        String?
  analysisJson Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project?     @relation(fields: [projectId], references: [id])
  templates    VideoTemplate[]
  blocks       Block[]
}

model VideoTemplate {
  id            String   @id @default(cuid())
  name          String
  stylePreset   String
  sourceUploadId String
  durationSec   Float
  fps           Float    @default(24)
  aspectRatio   String   @default("16:9")
  lut           String?
  templateJson  Json
  s3Key         String?
  thumbnailUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sourceUpload  VideoUpload @relation(fields: [sourceUploadId], references: [id])
  projects      Project[]
}

/** Stock intro clips cached from Pexels (primary) / Pixabay (backup) → R2 */
model IntroTemplate {
  id           String   @id @default(cuid())
  type         String   @default("intro")
  category     String
  name         String
  source       String
  externalId   String
  r2Key        String?
  r2Url        String?
  thumbnailUrl String?
  coverUrl     String?
  durationSec  Float    @default(0)
  tags         String[] @default([])
  license      String   @default("free-commercial")
  query        String?
  bytes        BigInt?
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, externalId])
  @@index([type, category])
}

model Block {
  id           String      @id @default(cuid())
  projectId    String
  uploadId     String?
  index        Int
  title        String
  durationSec  Float       @default(300)
  status       BlockStatus @default(PENDING)
  videoS3Key   String?
  jsonS3Key    String?
  archive5Json Json?
  templateId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id])
  upload       VideoUpload? @relation(fields: [uploadId], references: [id])

  @@unique([projectId, index])
}

model Asset {
  id        String   @id @default(cuid())
  projectId String?
  type      String
  key       String
  url       String?
  mimeType  String?
  bytes     BigInt?
  checksum  String?
  labels    String[] @default([])
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id])
}

model SoulIdentity {
  id        String   @id @default(cuid())
  projectId String
  name      String
  faceHash  String
  frontKey  String?
  leftKey   String?
  rightKey  String?
  threeQKey String?
  loraRef   String?
  locked    Boolean  @default(true)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model RoomPlate {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  wideKey       String?
  mediumKey     String?
  oshKey        String?
  closeKey      String?
  lightingLocked Boolean @default(true)
  lut           String?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id])
}

model StoryboardFrame {
  id        String   @id @default(cuid())
  projectId String
  shotIndex Int
  prompt    String?
  imageKey  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model MasterCut {
  id        String   @id @default(cuid())
  projectId String
  title     String
  blockIds  String[]
  s3Key     String?
  durationSec Float?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

/// Sound Studio — cloned / library voices for Voice Forge
model VoiceProfile {
  id           String   @id @default(cuid())
  projectId    String?
  name         String
  provider     String   @default("elevenlabs")
  providerVoiceId String?
  sampleAssetIds String[] @default([])
  status       String   @default("ready") // pending | cloning | ready | failed
  error        String?
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project? @relation(fields: [projectId], references: [id])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // dashscope | elevenlabs | openai | ollama
  label     String
  keyEnc    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, provider, label])
}

model JobRecord {
  id        String    @id @default(cuid())
  queue     String
  jobId     String    @unique
  status    JobStatus @default(QUEUED)
  payload   Json
  result    Json?
  error     String?
  progress  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Academy studio running ReelStorm under their own brand
model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  ownerId       String
  tier          SubTier  @default(storm_pro)
  status        String   @default("active") // active | suspended
  customDomain  String?
  webhookUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation("TenantOwner", fields: [ownerId], references: [id])
  brand         TenantBrand?
  wlKeys        WhiteLabelKey[]
  wallet        RtcWallet?
}

model TenantBrand {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  productName  String
  monogram     String  @default("RS")
  primaryHex   String  @default("#7C3AED")
  accentHex    String  @default("#00D9FF")
  ctaHex       String  @default("#FF7A00")
  bgHex        String  @default("#080808")
  logoUrl      String?
  supportEmail String?
  hideReelstorm Boolean @default(false)
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Opaque key for Academy white-label REST API (rs_live_…)
model WhiteLabelKey {
  id         String    @id @default(cuid())
  tenantId   String
  label      String
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]  @default(["templates:read", "generate:write", "archive:read"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RtcWallet {
  id             String   @id @default(cuid())
  userId         String?  @unique
  tenantId       String?  @unique
  balanceRtc     Int      @default(0)
  lifetimeIn     Int      @default(0)
  lifetimeOut    Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  ledger         RtcLedger[]
}

model RtcLedger {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // GRANT | PURCHASE | DEBIT_ARCHIVE5 | DEBIT_GENERATE | ADJUST | REFUND | GIFT | VOUCHER
  amountRtc   Int      // signed: +credit / -debit
  balanceAfter Int
  refType     String?
  refId       String?
  note        String?
  createdAt   DateTime @default(now())
  wallet      RtcWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

/// Admin-issued gift credit voucher (redeem once by any registered user)
model GiftVoucher {
  id          String    @id @default(cuid())
  code        String    @unique
  amountRtc   Int
  note        String?
  createdBy   String
  redeemedBy  String?
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([redeemedAt])
}

/// Singleton pool for 1-RTC free demos (4600 RTC = 920 × 5-min sets)
model SystemBank {
  id            String   @id @default("reelstorm-system-bank")
  totalRTC      Int      @default(4600)
  usedRTC       Int      @default(0)
  remainingRTC  Int      @default(4600)
  totalSets     Int      @default(920)
  rtcPerSet     Int      @default(5)
  costBasis     Float    @default(1.93)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

/// Viral Clone Factory — transformative remake jobs (inspiration URL, never copy bytes)
model CloneJob {
  id                   String   @id @default(cuid())
  userId               String?
  sourceUrl            String
  platform             String // youtube | shorts | tiktok | instagram
  videoId              String?
  title                String?
  transcript           String?
  rewrittenTranscript  String?
  hook                 String?
  bodyPoints           Json?
  cta                  String?
  durationSec          Int?
  visualStyle          String?
  pacing               Json?
  thumbnailUrl         String?
  tags                 String[] @default([])
  status               String   @default("analyzed") // analyzed | reproducing | completed | failed
  style                String? // original | kids | gaming | a24
  r2Url                String?
  r2Key                String?
  youtubeUrl           String?
  rtcCostAnalyze       Int      @default(1)
  rtcCostReproduce     Int      @default(5)
  watermarkNote        String?  @default("Inspired by original — transformative remake via REELSTORM")
  error                String?
  meta                 Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([platform])
}

model YtChannel {
  id                String    @id @default(cuid())
  userId            String
  youtubeChannelId  String?
  channelName       String?
  niche             String?
  oauthAccessToken  String?
  oauthRefreshToken String?
  connectedAt       DateTime?
  isConnected       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ViralBreakdown {
  id               String   @id @default(cuid())
  niche            String
  sourceVideoId    String?
  sourceUrl        String?
  title            String?
  views            BigInt?
  hook             String?
  structure        Json?
  whyViral         String?
  rebuiltConcepts  Json?
  createdAt        DateTime @default(now())

  @@index([niche, createdAt])
}

model YtScript {
  id            String   @id @default(cuid())
  userId        String?
  hookFormula   Int
  topic         String
  niche         String?
  fullScript    String
  shortsScript  String?
  timestamps    Json?
  rtcCost       Int      @default(1)
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])
  packages      YtPackage[]
  calendar      ContentCalendarEntry[]

  @@index([userId, createdAt])
}

model YtPackage {
  id                 String   @id @default(cuid())
  scriptId           String?
  titles             String[] @default([])
  description        String?
  tags               String[] @default([])
  thumbnails         String[] @default([])
  selectedTitle      String?
  selectedThumbnail  String?
  ctr                Float?
  createdAt          DateTime @default(now())
  script             YtScript? @relation(fields: [scriptId], references: [id])
}

model ThumbnailAb {
  id            String   @id @default(cuid())
  videoId       String?
  variantAUrl   String?
  variantBUrl   String?
  variantCUrl   String?
  impressionsA  Int      @default(0)
  clicksA       Int      @default(0)
  impressionsB  Int      @default(0)
  clicksB       Int      @default(0)
  impressionsC  Int      @default(0)
  clicksC       Int      @default(0)
  ctrA          Float?
  ctrB          Float?
  ctrC          Float?
  winner        String?
  createdAt     DateTime @default(now())
}

model CommentReply {
  id               String   @id @default(cuid())
  videoId          String?
  commentId        String?
  originalComment  String
  replyText        String
  autoReplied      Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([videoId, createdAt])
}

model ContentCalendarEntry {
  id              String    @id @default(cuid())
  userId          String?
  date            DateTime  @db.Date
  type            String // Long | Short
  scriptId        String?
  status          String    @default("planned") // planned | produced | published
  scheduledAt     DateTime?
  youtubeVideoId  String?
  rtcEstimate     Int       @default(1)
  title           String?
  createdAt       DateTime  @default(now())
  user            User?     @relation(fields: [userId], references: [id])
  script          YtScript? @relation(fields: [scriptId], references: [id])

  @@index([userId, date])
}

/// ReelStorm Studio (desktop) — centralized minute control; user's GPU does compute
enum StudioPlan {
  free
  starter
  pro
  agency
  unlimited
}

enum StudioLicenseStatus {
  active
  past_due
  canceled
  revoked
  limit_reached
}

model StudioLicense {
  id                   String              @id @default(cuid())
  userId               String
  /// SHA-256 of full license JWT (never store plaintext key)
  keyHash              String              @unique
  /// Display only e.g. RSTUDIO-…XXXX
  keyPrefix            String
  plan                 StudioPlan          @default(starter)
  monthlyLimit         Int
  usedThisMonth        Float               @default(0)
  devicesAllowed       Int                 @default(1)
  /// First activated hardware fingerprint — free trial is locked to this device
  lockedFingerprint    String?
  /// How many times a NEW fingerprint was approved (paid plans only; free stays 0)
  deviceTransferCount  Int                 @default(0)
  stripeSubscriptionId String?
  stripePriceId        String?
  status               StudioLicenseStatus @default(active)
  jwtVersion           Int                 @default(1)
  periodStart          DateTime            @default(now())
  expiresAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices              StudioDevice[]
  usageLogs            StudioUsageLog[]

  @@index([userId, status])
  @@index([stripeSubscriptionId])
  @@index([lockedFingerprint])
}

model StudioDevice {
  id                 String    @id @default(cuid())
  licenseId          String
  fingerprint        String
  deviceName         String?
  /// SHA-256 of current activated_token (short-lived)
  activatedTokenHash String?
  activatedAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  revoked            Boolean   @default(false)
  license            StudioLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, fingerprint])
  @@index([fingerprint])
}

model StudioUsageLog {
  id            String   @id @default(cuid())
  licenseId     String
  deviceId      String?
  minutes       Float
  videoHash     String?
  promptHash    String?
  /// R2 public URL when generated via GPU saver (0MB web / thin desktop)
  outputUrl     String?
  offlineQueued Boolean  @default(false)
  createdAt     DateTime @default(now())
  license       StudioLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
}
